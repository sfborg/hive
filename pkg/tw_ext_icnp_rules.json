{
  "name": "tw_ext_icnp_sfga",
  "version": "0.2.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "TaxonWorks-derived validation rules for names governed by the ICNP (col__code_id BACTERIAL). These rules need the TaxonWorks round-trip columns, which are a proposal against the sfga schema and not yet adopted: the bundle's requires block names them, and hive skips the bundle and reports the missing columns when an archive does not have them. Each rule's description names the TaxonWorks class and method it is ported from. Statuses are matched as NOMEN ontology URIs in name.col__status_id. Relations are declared in hive_rules.json. Schema compatibility: SFGA v0.3.x.",
  "created_at": "2026-09-22T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": [],
    "columns": {
      "name.tw__author_ids": "text",
      "name.tw__nomenclatural_classification": "text",
      "name.tw__reference_original": "text",
      "name_relation.tw__name_relationship_type": "text"
    },
    "relations": ["name:element-originalgenus"]
  },
  "relations": {},
  "supersedes": ["tw_icnp_missing_author_links", "tw_icnp_missing_original_author_links", "tw_icnp_missing_original_publication", "tw_icnp_status_code_mismatch", "tw_icnp_status_not_specific"],
  "rules": [
    {
      "rule_id": "tw_ext_icnp_status_code_mismatch",
      "table_name": "name",
      "field_name": "tw__nomenclatural_classification",
