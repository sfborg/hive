    {
      "rule_id": "hive_taxon_parent_cycle",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Taxon sits on a parent-chain cycle",
      "validator_type": "no_self_cycle",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {
        "parent_column": "col__parent_id"
      },
      "error_message": "This taxon's parent chain loops back to itself. Break the cycle by re-parenting one of the taxa on the loop.",
      "warning_message": "",
      "is_active": true,
      "priority": 5
    },
    {
      "rule_id": "hive_name_on_self_relation",
      "table_name": "name",
      "field_name": "col__id",
      "rule_name": "Name appears on both sides of a name_relation row",
      "validator_type": "count_across",
      "enforcement": "soft",
      "severity": "error",
      "parameters": {
        "table": "name_relation",
        "match": [
          {
            "target": "col__name_id",
            "self": "col__id"
          },
          {
            "target": "col__related_name_id",
            "self": "col__id"
          }
        ],
        "expected": {
          "max": 0
        }
      },
      "error_message": "This name appears on both sides of a name-relation link. Delete the link or repoint one side to a different name.",
      "warning_message": "",
      "is_active": true,
      "priority": 6
    },
    {
      "rule_id": "hive_probable_incertae_sedis",
      "table_name": "taxon",
      "field_name": "",
      "rule_name": "Probable incertae sedis (ICZN species under non-genus)",
      "validator_type": "related_field_in_set",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {
          "relation": "taxon:owning-name",
          "field": "col__code_id",
          "operator": "equals",
          "value": "ZOOLOGICAL"
        },
        {
          "relation": "taxon:owning-name",
          "field": "col__rank_id",
          "operator": "equals",
          "value": "SPECIES"
        }
      ],
      "parameters": {
        "relation": "taxon:parent-owning-name",
        "related_field": "col__rank_id",
        "allowed_values": [
          "GENUS",
          "SUBGENUS",
          "INFRAGENUS"
        ],
        "skip_if_empty": true
      },
      "error_message": "",
      "warning_message": "Species attached to a parent that isn't a genus. Under ICZN this can be a legitimate incertae sedis placement — consider marking the record explicitly so other tools render it correctly.",
      "is_active": true,
      "priority": 10
    },
    {
      "rule_id": "hive_source_year_mismatch",
      "table_name": "name",
      "field_name": "col__published_in_year",
      "rule_name": "Publication year matches source reference",
      "validator_type": "related_field_equals",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {
        "relation": "name:reference",
        "field": "col__published_in_year",
        "related_field": "col__issued",
        "skip_if_either_empty": true
      },
      "error_message": "",
      "warning_message": "Publication year on the name doesn't match the year on the referenced source. Check whether the name or the reference carries the wrong year.",
      "is_active": true,
      "priority": 30
