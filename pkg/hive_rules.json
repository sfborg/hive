{
  "name": "hive_sfga",
  "version": "0.1.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "hive-authored validation rules against SFGA archives.",
  "created_at": "2026-08-11T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": [
      "name",
      "taxon",
      "metadata",
      "reference",
      "name_relation"
    ],
    "columns": {
      "name.col__id": "text",
      "name.col__code_id": "text",
      "name.col__rank_id": "text",
      "name.col__reference_id": "text",
      "name.col__published_in_year": "text",
      "name.col__specific_epithet": "text",
      "name.gn__canonical_simple": "text",
      "name.gn__parse_quality": "integer",
      "taxon.col__id": "text",
      "taxon.col__name_id": "text",
      "taxon.col__parent_id": "text",
      "reference.col__id": "text",
      "reference.col__issued": "text",
      "reference.col__isbn": "text",
      "reference.col__issn": "text",
      "reference.col__doi": "text",
      "name.col__uninomial": "text",
      "name.col__genus": "text",
      "name.col__infraspecific_epithet": "text",
      "name.col__infrageneric_epithet": "text",
      "name.col__authorship": "text",
      "creator.col__id": "integer",
      "creator.col__orcid": "text",
      "creator.col__rorid": "text",
      "creator.col__email": "text",
      "contact.col__id": "integer",
      "contact.col__orcid": "text",
      "contact.col__rorid": "text",
      "contact.col__email": "text",
      "contributor.col__id": "integer",
      "contributor.col__orcid": "text",
      "contributor.col__rorid": "text",
      "contributor.col__email": "text",
      "editor.col__id": "integer",
      "editor.col__orcid": "text",
      "editor.col__rorid": "text",
      "editor.col__email": "text",
      "publisher.col__id": "integer",
      "publisher.col__orcid": "text",
      "publisher.col__rorid": "text",
      "publisher.col__email": "text",
      "name_relation.col__name_id": "text",
      "name_relation.col__related_name_id": "text",
      "name_relation.col__type_id": "text",
      "metadata.col__id": "integer"
    },
    "relations": [
      "taxon:owning-name",
      "taxon:parent-owning-name",
      "name:reference",
      "name:original-combination",
      "name:replaced-name",
      "name:original-spelling"
    ]
  },
  "relations": {
    "taxon:owning-name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {
          "from": "taxon.col__name_id",
          "to": "name.col__id"
        }
      ],
      "description": "From a taxon row, walk to its owning name."
    },
    "taxon:parent-owning-name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {
          "from": "taxon.col__parent_id",
          "to": "taxon.col__id",
          "alias": "parent"
        },
        {
          "from": "parent.col__name_id",
          "to": "name.col__id"
        }
      ],
      "description": "From a source taxon, walk to its parent taxon then to the parent's owning name."
    },
    "name:reference": {
      "target_table": "reference",
      "cardinality": "one",
      "join": [
        {
          "from": "name.col__reference_id",
          "to": "reference.col__id"
        }
      ],
      "description": "From a name row, walk to its publication reference."
    },
    "name:original-combination": {
      "target_table": "name",
      "target_alias": "original_combination",
      "cardinality": "one",
      "join": [
        {
          "from": "name.col__id",
          "to": "name_relation.col__name_id",
          "where": [
            {
              "column": "col__type_id",
              "equals": "BASIONYM"
            }
          ]
        },
        {
          "from": "name_relation.col__related_name_id",
          "to": "name.col__id",
          "alias": "original_combination"
        }
      ],
      "description": "From a subsequent-combination name row, walk through the BASIONYM name_relation to reach the original combination's name row."
    },
    "name:replaced-name": {
      "target_table": "name",
      "target_alias": "replaced_name",
      "cardinality": "one",
      "join": [
        {
          "from": "name.col__id",
          "to": "name_relation.col__name_id",
          "where": [
            {
              "column": "col__type_id",
              "equals": "REPLACEMENT_NAME"
            }
          ]
        },
        {
          "from": "name_relation.col__related_name_id",
          "to": "name.col__id",
          "alias": "replaced_name"
        }
      ],
      "description": "From a replacement name (nomen novum) row, walk through the REPLACEMENT_NAME name_relation to reach the replaced name's row."
    },
    "name:original-spelling": {
      "target_table": "name",
      "target_alias": "original_spelling",
      "cardinality": "one",
      "join": [
        {
          "from": "name.col__id",
          "to": "name_relation.col__name_id",
          "where": [
            {
              "column": "col__type_id",
              "equals": "SPELLING_CORRECTION"
            }
          ]
        },
        {
          "from": "name_relation.col__related_name_id",
          "to": "name.col__id",
          "alias": "original_spelling"
        }
      ],
      "description": "From a corrected-spelling name row, walk through the SPELLING_CORRECTION name_relation to reach the original spelling's row."
    },
    "taxon:parent-taxon": {
      "target_table": "taxon",
      "target_alias": "parent_taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "taxon.col__parent_id",
          "to": "taxon.col__id",
          "alias": "parent_taxon"
        }
      ],
      "description": "From a taxon row, walk to its parent taxon."
    },
    "synonym:taxon": {
      "target_table": "taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "synonym.col__taxon_id",
          "to": "taxon.col__id"
        }
      ],
      "description": "From a synonym row, walk to the accepted taxon it points at."
    },
    "synonym:name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {
          "from": "synonym.col__name_id",
          "to": "name.col__id"
        }
      ],
      "description": "From a synonym row, walk to the name row it points at."
    },
    "name_relation:subject-name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {
          "from": "name_relation.col__name_id",
          "to": "name.col__id"
        }
      ],
      "description": "From a name_relation row, walk to its subject name."
    },
    "name_relation:related-name": {
      "target_table": "name",
      "target_alias": "related_name",
      "cardinality": "one",
      "join": [
        {
          "from": "name_relation.col__related_name_id",
          "to": "name.col__id",
          "alias": "related_name"
        }
      ],
      "description": "From a name_relation row, walk to its related (object) name."
    },
    "species_interaction:taxon": {
      "target_table": "taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "species_interaction.col__taxon_id",
          "to": "taxon.col__id"
        }
      ],
      "description": "From a species_interaction row, walk to its subject taxon."
    },
    "species_interaction:related-taxon": {
      "target_table": "taxon",
      "target_alias": "related_taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "species_interaction.col__related_taxon_id",
          "to": "taxon.col__id",
          "alias": "related_taxon"
        }
      ],
      "description": "From a species_interaction row, walk to its related (object) taxon."
    },
    "species_interaction:type": {
      "target_table": "species_interaction_type",
      "cardinality": "one",
      "join": [
        {
          "from": "species_interaction.col__type_id",
          "to": "species_interaction_type.col__id"
        }
      ],
      "description": "From a species_interaction row, walk to its type term."
    },
    "vernacular:taxon": {
      "target_table": "taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "vernacular.col__taxon_id",
          "to": "taxon.col__id"
        }
      ],
      "description": "From a vernacular row, walk to its owning taxon."
    },
    "distribution:taxon": {
      "target_table": "taxon",
      "cardinality": "one",
      "join": [
        {
          "from": "distribution.col__taxon_id",
          "to": "taxon.col__id"
        }
      ],
      "description": "From a distribution row, walk to its owning taxon."
    }
  },
  "rules": [
    {
      "rule_id": "hive_creator_orcid_check_digit",
      "table_name": "creator",
      "field_name": "col__orcid",
      "rule_name": "Check digit invalid on creator's ORCID iD",
      "validator_type": "check_digit",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {
        "algorithm": "orcid"
      },
      "error_message": "",
