      "is_active": true,
      "priority": 30
    },
    {
      "rule_id": "hive_taxon_parent_cycle",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Taxon sits on a parent-chain cycle",
      "validator_type": "no_self_cycle",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {
        "parent_column": "col__parent_id"
      },
      "error_message": "This taxon's parent chain loops back to itself. Break the cycle by re-parenting one of the taxa on the loop.",
      "warning_message": "",
      "is_active": true,
      "priority": 5
    },
    {
      "rule_id": "hive_name_on_self_relation",
      "table_name": "name",
      "field_name": "col__id",
      "rule_name": "Name appears on both sides of a name_relation row",
      "validator_type": "count_across",
      "enforcement": "soft",
      "severity": "error",
      "parameters": {
        "table": "name_relation",
        "match": [
          {"target": "col__name_id",         "self": "col__id"},
          {"target": "col__related_name_id", "self": "col__id"}
        ],
        "expected": {"max": 0}
      },
      "error_message": "This name appears on both sides of a name_relation row (self-referenced relation). Delete the row or repoint one side to a different name.",
      "warning_message": "",
      "is_active": true,
      "priority": 6
    },
    {
      "rule_id": "hive_name_reference_id_invalid",
      "table_name": "name",
      "field_name": "col__reference_id",
      "rule_name": "Name references a nonexistent reference row",
      "validator_type": "foreign_key_exists",
      "enforcement": "soft",
      "severity": "error",
      "parameters": {
        "field": "col__reference_id",
        "relation": "name:reference"
      },
      "error_message": "col__reference_id points at a reference row that does not exist. Fix the reference id or clear the field.",
      "warning_message": "",
      "is_active": true,
      "priority": 8
    },
    {
      "rule_id": "hive_published_before_genus",
      "table_name": "taxon",
      "field_name": "col__published_in_year",
      "rule_name": "Species published before its parent genus",
      "validator_type": "ancestor_field_check",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"relation": "taxon:owning-name", "field": "col__rank_id", "operator": "equals", "value": "SPECIES"}
      ],
      "parameters": {
        "parent_column": "col__parent_id",
        "stop_when": {
          "join": {"from": "col__name_id", "to": "name.col__id"},
          "field": "col__rank_id",
          "operator": "equals",
          "value": "GENUS"
        },
        "assert": {
          "self_join": {"from": "col__name_id", "to": "name.col__id"},
          "self_field": "col__published_in_year",
          "ancestor_join": {"from": "col__name_id", "to": "name.col__id"},
          "ancestor_field": "col__published_in_year",
          "operator": "greater_than_or_equals"
        }
      },
      "error_message": "",
      "warning_message": "Species publication year predates the parent genus's publication year. Verify both years and the taxonomic placement.",
      "is_active": true,
      "priority": 25
    },
    {
      "rule_id": "hive_species_missing_genus_ancestor",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Species taxon has no genus-group ancestor",
      "validator_type": "ancestor_exists",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"relation": "taxon:owning-name", "field": "col__rank_id", "operator": "equals", "value": "SPECIES"}
      ],
      "parameters": {
        "parent_column": "col__parent_id",
        "match": {
          "join": {"from": "col__name_id", "to": "name.col__id"},
          "field": "col__rank_id",
          "operator": "in",
          "value": ["GENUS", "SUBGENUS", "INFRAGENUS"]
        }
      },
      "error_message": "",
      "warning_message": "Species taxon has no genus-group (GENUS / SUBGENUS / INFRAGENUS) ancestor in its parent chain. Reparent so the placement resolves under a genus.",
      "is_active": true,
      "priority": 12
    },
    {
      "rule_id": "hive_infraspecies_missing_species_ancestor",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Infraspecific taxon has no species ancestor",
      "validator_type": "ancestor_exists",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"relation": "taxon:owning-name", "field": "col__rank_id", "operator": "in", "value": ["SUBSPECIES","VARIETY","FORM","SUBVARIETY","SUBFORM"]}
      ],
      "parameters": {
        "parent_column": "col__parent_id",
        "match": {
          "join": {"from": "col__name_id", "to": "name.col__id"},
          "field": "col__rank_id",
          "operator": "equals",
          "value": "SPECIES"
        }
      },
      "error_message": "",
      "warning_message": "Infraspecific taxon has no species ancestor in its parent chain. Reparent so the placement resolves under a species.",
      "is_active": true,
      "priority": 12
    },
    {
      "rule_id": "hive_parent_rank_higher",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Parent taxon has a rank at or below the child",
      "validator_type": "parent_rank_higher",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {
        "parent_column": "col__parent_id",
        "rank_column": "col__rank_id",
        "code_column": "col__code_id",
        "join": {"from": "col__name_id", "to": "name.col__id"},
        "rank_order": {
          "BACTERIAL": ["KINGDOM", "PHYLUM", "CLASS", "SUBCLASS", "ORDER", "SUBORDER", "FAMILY", "SUBFAMILY", "TRIBE", "SUBTRIBE", "GENUS", "SUBGENUS", "SPECIES", "SUBSPECIES"],
          "BOTANICAL": ["KINGDOM", "SUBKINGDOM", "PHYLUM", "SUBPHYLUM", "CLASS", "SUBCLASS", "SUPERORDER", "ORDER", "SUBORDER", "FAMILY", "SUBFAMILY", "TRIBE", "SUBTRIBE", "GENUS", "SUBGENUS", "SECTION", "SUBSECTION", "SERIES", "SUBSERIES", "SPECIES", "SUBSPECIES", "VARIETY", "SUBVARIETY", "FORM", "SUBFORM"],
          "VIRUS": ["REALM", "KINGDOM", "PHYLUM", "CLASS", "ORDER", "FAMILY", "SUBFAMILY", "GENUS", "SPECIES"],
          "ZOOLOGICAL": ["SUPERKINGDOM", "KINGDOM", "SUBKINGDOM", "INFRAKINGDOM", "SUPERPHYLUM", "PHYLUM", "SUBPHYLUM", "INFRAPHYLUM", "SUPERCLASS", "CLASS", "SUBCLASS", "INFRACLASS", "SUPERCOHORT", "COHORT", "MAGNORDER", "SUPERORDER", "MIRORDER", "ORDER", "SUBORDER", "INFRAORDER", "PARVORDER", "NANORDER", "SUPERFAMILY", "EPIFAMILY", "FAMILY", "SUPERSUBFAMILY", "SUBFAMILY", "INFRAFAMILY", "SUPERTRIBE", "TRIBE", "SUBTRIBE", "INFRATRIBE", "SUPERGENUS", "GENUS", "SUPERSUPERSUBGENUS", "SUPERSUBGENUS", "SUBGENUS", "INFRAGENUS", "SUPERSUPERSPECIES", "SUPERSPECIES", "SUBSUPERSPECIES", "SPECIES", "SUBSPECIES"]
        }
      },
      "error_message": "",
      "warning_message": "Parent taxon's rank is at or below this taxon's rank. Reparent under a higher-rank taxon.",
      "is_active": true,
      "priority": 10
    },
    {
      "rule_id": "hive_probable_incertae_sedis",
      "table_name": "taxon",
      "field_name": "",
      "rule_name": "Probable incertae sedis (ICZN species under non-genus)",
      "validator_type": "related_field_in_set",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"relation": "taxon:owning-name", "field": "col__code_id", "operator": "equals", "value": "ZOOLOGICAL"},
        {"relation": "taxon:owning-name", "field": "col__rank_id", "operator": "equals", "value": "SPECIES"}
      ],
      "parameters": {
        "relation": "taxon:parent-owning-name",
        "related_field": "col__rank_id",
        "allowed_values": ["GENUS", "SUBGENUS", "INFRAGENUS"],
        "skip_if_empty": true
      },
      "error_message": "",
      "warning_message": "Species attached to a parent that isn't a genus-group rank. Under ICZN this is a legitimate incertae sedis placement; consider marking the record explicitly so downstream consumers render it correctly.",
      "is_active": true,
      "priority": 10
    },
    {
      "rule_id": "hive_source_year_mismatch",
      "table_name": "name",
      "field_name": "col__published_in_year",
      "rule_name": "Publication year matches source reference",
      "validator_type": "related_field_equals",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {
        "relation": "name:reference",
        "field": "col__published_in_year",
        "related_field": "col__issued",
        "skip_if_either_empty": true
      },
      "error_message": "",
      "warning_message": "Publication year on the name doesn't match the year on the referenced source. Check whether the name or the reference carries the wrong year.",
      "is_active": true,
      "priority": 30
    },
    {
      "rule_id": "hive_specific_epithet_on_suprageneric",
      "table_name": "name",
      "field_name": "col__specific_epithet",
      "rule_name": "Specific epithet set on a rank above species",
      "validator_type": "absence",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"field": "col__rank_id", "operator": "not_in", "value": ["SPECIES","SUBSPECIES","VARIETY","FORM","SUBVARIETY","SUBFORM"]}
      ],
      "parameters": {},
      "error_message": "",
      "warning_message": "Specific epithet is set on a name whose rank is above species. Check the rank or clear the epithet.",
      "is_active": true,
      "priority": 45
    },
    {
      "rule_id": "hive_duplicate_name",
      "table_name": "name",
      "field_name": "gn__canonical_simple",
      "rule_name": "Duplicate scientific name",
      "validator_type": "count_across",
      "enforcement": "soft",
      "severity": "info",
      "parameters": {
        "table": "name",
        "match": [
          {"target": "gn__canonical_simple", "self": "gn__canonical_simple"}
        ],
        "exclude_self": true,
        "expected": {"max": 0}
      },
      "error_message": "",
      "warning_message": "Another name record shares this scientific name (ignoring authorship). Confirm whether these are separate nomenclatural acts (potential homonyms) or duplicate entries that should be merged.",
      "is_active": true,
      "priority": 40
    },
    {
      "rule_id": "hive_parse_failed",
      "table_name": "name",
      "field_name": "gn__parse_quality",
      "rule_name": "Scientific name could not be parsed",
      "validator_type": "range",
      "enforcement": "soft",
      "severity": "error",
      "conditions": [
        {"field": "gn__parse_quality", "operator": "equals", "value": 0}
      ],
      "parameters": {"min": 1},
      "error_message": "",
      "warning_message": "Scientific name could not be parsed. Check for typos, stray characters, or missing spaces.",
      "is_active": true,
      "priority": 20
    },
    {
      "rule_id": "hive_parse_warnings",
      "table_name": "name",
      "field_name": "gn__parse_quality",
      "rule_name": "Parser recorded warnings on the scientific name",
      "validator_type": "range",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {"field": "gn__parse_quality", "operator": "greater_than", "value": 1}
      ],
      "parameters": {"min": 1, "max": 1},
      "error_message": "",
      "warning_message": "Parser recorded warnings on this name. Open the record and confirm the atomized fields (canonical, epithets, authorship) match what you intended.",
      "is_active": true,
      "priority": 20
    }
  ]
}
