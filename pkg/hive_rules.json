    {
      "rule_id": "hive_creator_email_format",
      "table_name": "creator",
      "field_name": "col__email",
      "rule_name": "Unusual email format on creator",
      "validator_type": "regex",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [
        {
          "field": "col__email",
          "operator": "not_equals",
          "value": ""
        }
      ],
      "parameters": {
        "pattern": "^[a-zA-Z0-9._+-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$"
      },
      "error_message": "",
      "warning_message": "Email address may be invalid — the format looks unusual. Confirm the value is correct.",
      "is_active": true,
      "priority": 40
    },
