{
  "name": "hive_sfga",
  "version": "0.1.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "hive-authored validation rules against SFGA archives.",
  "created_at": "2026-08-11T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": ["name", "taxon", "metadata", "reference", "name_relation"],
    "columns": {
      "name.col__id": "text",
      "name.col__code_id": "text",
      "name.col__rank_id": "text",
      "name.col__reference_id": "text",
      "name.col__published_in_year": "text",
      "name.col__specific_epithet": "text",
      "name.gn__canonical_simple": "text",
      "name.gn__parse_quality": "integer",
      "taxon.col__id": "text",
      "taxon.col__name_id": "text",
      "taxon.col__parent_id": "text",
      "reference.col__id": "text",
      "reference.col__issued": "text",
      "reference.col__isbn": "text",
      "reference.col__issn": "text",
      "reference.col__doi": "text",
      "creator.col__id": "integer",
      "creator.col__orcid": "text",
      "creator.col__rorid": "text",
      "contact.col__id": "integer",
      "contact.col__orcid": "text",
      "contact.col__rorid": "text",
      "contributor.col__id": "integer",
      "contributor.col__orcid": "text",
      "contributor.col__rorid": "text",
      "editor.col__id": "integer",
      "editor.col__orcid": "text",
      "editor.col__rorid": "text",
      "publisher.col__id": "integer",
      "publisher.col__orcid": "text",
      "publisher.col__rorid": "text",
      "name_relation.col__name_id": "text",
      "name_relation.col__related_name_id": "text",
      "metadata.col__id": "integer"
    },
    "relations": ["taxon:owning-name", "taxon:parent-owning-name", "name:reference"]
  },
  "relations": {
    "taxon:owning-name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {"from": "taxon.col__name_id", "to": "name.col__id"}
      ],
      "description": "From a taxon row, walk to its owning name."
    },
    "taxon:parent-owning-name": {
      "target_table": "name",
      "cardinality": "one",
      "join": [
        {"from": "taxon.col__parent_id", "to": "taxon.col__id", "alias": "parent"},
        {"from": "parent.col__name_id", "to": "name.col__id"}
      ],
      "description": "From a source taxon, walk to its parent taxon then to the parent's owning name."
    },
    "name:reference": {
      "target_table": "reference",
      "cardinality": "one",
      "join": [
        {"from": "name.col__reference_id", "to": "reference.col__id"}
      ],
      "description": "From a name row, walk to its publication reference."
    }
  },
  "rules": [
    {
      "rule_id": "hive_creator_orcid_check_digit",
      "table_name": "creator",
      "field_name": "col__orcid",
      "rule_name": "Creator ORCID check digit invalid",
      "validator_type": "check_digit",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {
        "algorithm": "orcid"
      },
      "error_message": "",
      "warning_message": "ORCID check digit doesn't match the payload. Likely a typo — a single-digit substitution or adjacent-digit transposition.",
      "is_active": true,
      "priority": 30
    },
