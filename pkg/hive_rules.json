{
  "name": "hive_sfga",
  "version": "0.1.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "hive-authored validation rules against SFGA archives.",
  "created_at": "2026-08-11T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": ["name", "taxon", "metadata"],
    "columns": {
      "name.col__id": "text",
      "name.col__code_id": "text",
      "name.col__rank_id": "text",
      "name.gn__parse_quality": "integer",
      "taxon.col__id": "text",
      "taxon.col__name_id": "text",
      "taxon.col__parent_id": "text",
      "metadata.col__id": "integer"
    }
  },
  "rules": [
    {
      "rule_id": "hive_probable_incertae_sedis",
      "table_name": "name",
      "field_name": "",
      "rule_name": "Probable incertae sedis (ICZN species under non-genus)",
      "validator_type": "sfga_parent_rank",
      "validation_type": "soft",
      "conditions": [
        {"field": "col__code_id", "operator": "equals", "value": "ZOOLOGICAL"},
        {"field": "col__rank_id", "operator": "equals", "value": "SPECIES"}
      ],
      "parameters": {
        "rank_hierarchy": {"SPECIES": ["GENUS", "SUBGENUS", "INFRAGENUS"]}
      },
      "error_message": "",
      "warning_message": "Species attached to a parent that isn't a genus-group rank. Under ICZN this is a legitimate incertae sedis placement; consider marking the record explicitly so downstream consumers render it correctly.",
      "is_active": true,
      "priority": 10
    },
    {
      "rule_id": "hive_parse_quality",
      "table_name": "name",
      "field_name": "gn__parse_quality",
      "rule_name": "gnparser flagged the scientific name",
      "validator_type": "sfga_parse_quality",
      "enforcement": "soft",
      "severity": "warn",
      "parameters": {},
      "error_message": "",
      "warning_message": "",
      "is_active": true,
      "priority": 20
    }
  ]
}
