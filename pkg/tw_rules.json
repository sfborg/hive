{
  "name": "tw_sfga",
  "version": "0.2.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "TaxonWorks-derived validation rules that apply to names of every nomenclatural code, to name relations, type material and references. Each rule's description names the TaxonWorks class and method it is ported from. Statuses are matched as NOMEN ontology URIs in name.col__status_id. Relations are declared in hive_rules.json. Schema compatibility: SFGA v0.3.x.",
  "created_at": "2026-09-22T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": [],
    "columns": {},
    "relations": ["name:holotype", "name:lectotype", "name:neotype", "name:parent-name", "name:synonym-usage", "name:syntype", "taxon:parent-taxon", "type_material:name"]
  },
  "relations": {},
  "rules": [
    {
      "rule_id": "tw_basionym_unique",
      "table_name": "name_relation",
      "field_name": "col__name_id",
      "rule_name": "One original combination per name",
      "description": "Ported from TaxonWorks TaxonNameRelationship validates_uniqueness_of :object_taxon_name_id for original combinations (app/models/taxon_name_relationship.rb).",
      "validator_type": "count_across",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "col__type_id", "operator": "equals", "value": "BASIONYM"}],
      "parameters": {
        "table": "name_relation",
        "match": [
          {"target": "col__name_id", "self": "col__name_id"},
          {"target": "col__type_id", "self": "col__type_id"}
        ],
        "exclude_self": true,
        "expected": {"max": 0}
      },
      "error_message": "This name has more than one original combination (basionym) link, or the same link twice. Keep a single link.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_parent_same_code",
      "table_name": "name",
      "field_name": "col__code_id",
      "rule_name": "Parent has the same nomenclatural code",
      "description": "Ported from TaxonWorks Protonym#validate_same_nomenclatural_code (app/models/protonym.rb).",
      "validator_type": "related_field_equals",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {"relation": "name:parent-name", "field": "col__code_id", "skip_if_either_empty": true},
      "error_message": "This name and its parent are governed by different nomenclatural codes.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_published_in_year_integer",
      "table_name": "name",
      "field_name": "col__published_in_year",
      "rule_name": "Year of publication is an integer",
      "description": "Ported from TaxonWorks TaxonName validates :year_of_publication, date_year (app/models/taxon_name.rb).",
      "validator_type": "regex",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "col__published_in_year", "operator": "not_equals", "value": ""}],
      "parameters": {"pattern": "^[0-9]+$"},
      "error_message": "The year of publication must be a whole number.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_published_in_year_range",
      "table_name": "name",
      "field_name": "col__published_in_year",
      "rule_name": "Year of publication is plausible",
      "description": "Ported from TaxonWorks TaxonName validates :year_of_publication, date_year (app/models/taxon_name.rb).",
      "validator_type": "range",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "col__published_in_year", "operator": "matches", "value": "^[0-9]+$"}],
      "parameters": {"min": 1000, "max": "current_year"},
      "error_message": "The year of publication must be between 1000 and the current year.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_rank_required",
      "table_name": "name",
      "field_name": "col__rank_id",
      "rule_name": "Rank is recorded",
      "description": "Ported from TaxonWorks Protonym validates_presence_of :rank_class (app/models/protonym.rb).",
      "validator_type": "presence",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {},
      "error_message": "Every name needs a rank.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_status_code_root",
      "table_name": "name",
      "field_name": "col__status_id",
      "rule_name": "Status is a specific nomenclatural status",
      "description": "Ported from TaxonWorks TaxonNameClassification#validate_taxon_name_classification (app/models/taxon_name_classification.rb).",
      "validator_type": "absence",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [
        {
          "field": "col__status_id",
          "operator": "in",
          "value": ["http://purl.obolibrary.org/obo/NOMEN_0000107", "http://purl.obolibrary.org/obo/NOMEN_0000109", "http://purl.obolibrary.org/obo/NOMEN_0000110", "http://purl.obolibrary.org/obo/NOMEN_0000111"]
        }
      ],
      "parameters": {},
      "error_message": "The status is only the name of a nomenclatural code. Choose a specific status.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_type_designation_unique",
      "table_name": "name_relation",
      "field_name": "col__name_id",
      "rule_name": "One type designation per name",
      "description": "Ported from TaxonWorks TaxonNameRelationship#validate_uniqueness_of_typification_object (app/models/taxon_name_relationship.rb).",
      "validator_type": "count_across",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "col__type_id", "operator": "equals", "value": "TYPE"}],
      "parameters": {
        "table": "name_relation",
        "match": [
          {"target": "col__name_id", "self": "col__name_id"},
          {"target": "col__type_id", "self": "col__type_id"}
        ],
        "exclude_self": true,
        "expected": {"max": 0}
      },
      "error_message": "This name has more than one type designation, or the same one twice. Keep a single type name relation.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_type_material_unique",
      "table_name": "type_material",
      "field_name": "col__status_id",
      "rule_name": "Type-material record is unique",
      "description": "Ported from TaxonWorks TypeMaterial validates_uniqueness_of :type_type (app/models/type_material.rb).",
      "validator_type": "count_across",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {
        "table": "type_material",
        "match": [
          {"target": "col__name_id", "self": "col__name_id"},
          {"target": "col__status_id", "self": "col__status_id"},
          {"target": "col__institution_code", "self": "col__institution_code"},
          {"target": "col__catalog_number", "self": "col__catalog_number"}
        ],
        "exclude_self": true,
        "expected": {"max": 0}
      },
      "error_message": "The same specimen is recorded twice with the same type status for this name.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_basionym_authorship_without_digits",
