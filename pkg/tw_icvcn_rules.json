    {
      "rule_id": "tw_icvcn_authorship_parentheses",
      "table_name": "name",
      "field_name": "col__authorship",
      "rule_name": "Authorship parentheses are closed",
      "description": "Ported from TaxonWorks Protonym#verbatim_author_with_closed_parens_when_present (app/models/protonym.rb).",
      "validator_type": "regex",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [
        {"field": "col__code_id", "operator": "equals", "value": "VIRUS"},
        {"field": "col__authorship", "operator": "not_equals", "value": ""}
      ],
      "parameters": {"pattern": "^(?:\\([^()]+\\)|[^()]+)$"},
      "error_message": "The authorship must either be wholly enclosed in one pair of parentheses or contain none.",
      "warning_message": "",
      "is_active": true,
      "priority": 20
    },
    {
