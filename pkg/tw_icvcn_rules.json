    {
      "rule_id": "tw_icvcn_type_designation_family_type_rank",
      "table_name": "name_relation",
      "field_name": "col__related_name_id",
      "rule_name": "Type of a family-group name is a genus-group name",
      "description": "Ported from TaxonWorks TaxonNameRelationship::Typification::Family/Genus#validate_subject_and_object_ranks (app/models/taxon_name_relationship/typification/*.rb).",
      "validator_type": "related_field_in_set",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [
        {"field": "col__type_id", "operator": "equals", "value": "TYPE"},
        {
          "field": "col__code_id",
          "operator": "equals",
          "value": "VIRUS",
          "relation": "name_relation:subject-name"
        },
        {
          "field": "col__rank_id",
          "operator": "in",
          "value": ["FAMILY", "SUBFAMILY"],
          "relation": "name_relation:subject-name"
        }
      ],
      "parameters": {
        "relation": "name_relation:related-name",
        "related_field": "col__rank_id",
        "allowed_values": ["GENUS"],
        "skip_if_empty": true
      },
      "error_message": "The type of a family-group name must be a genus-group name.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
