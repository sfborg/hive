{
  "name": "tw_icvcn_sfga",
  "version": "0.2.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "TaxonWorks-derived validation rules for names governed by the ICVCN (col__code_id VIRUS). Each rule's description names the TaxonWorks class and method it is ported from. Statuses are matched as NOMEN ontology URIs in name.col__status_id. Relations are declared in hive_rules.json. Schema compatibility: SFGA v0.3.x.",
  "created_at": "2026-09-22T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": [],
    "columns": {},
    "relations": ["name:synonym-usage", "name:type-name", "name_relation:related-name", "name_relation:subject-name", "taxon:owning-name", "taxon:parent-owning-name", "type_material:name"]
  },
  "relations": {},
  "rules": [
    {
      "rule_id": "tw_icvcn_parent_rank_higher",
      "table_name": "taxon",
      "field_name": "col__parent_id",
      "rule_name": "Parent rank is higher than the rank",
      "description": "Ported from TaxonWorks Protonym#validate_parent_rank_is_higher (app/models/protonym.rb).",
      "validator_type": "parent_rank_higher",
      "enforcement": "hard",
      "severity": "error",
      "parameters": {
        "parent_column": "col__parent_id",
        "rank_column": "col__rank_id",
        "code_column": "col__code_id",
        "join": {"from": "col__name_id", "to": "name.col__id"},
        "rank_order": {
          "VIRUS": ["REALM", "KINGDOM", "PHYLUM", "CLASS", "ORDER", "FAMILY", "SUBFAMILY", "GENUS", "SPECIES"]
        }
      },
      "error_message": "The parent's rank must be higher than this taxon's rank.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_icvcn_relation_same_code",
      "table_name": "name_relation",
      "field_name": "col__related_name_id",
      "rule_name": "Related names share the nomenclatural code",
      "description": "Ported from TaxonWorks TaxonNameRelationship#validate_subject_and_object_share_code (app/models/taxon_name_relationship.rb).",
      "validator_type": "related_field_in_set",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [
        {
          "field": "col__code_id",
          "operator": "equals",
          "value": "VIRUS",
          "relation": "name_relation:subject-name"
        }
      ],
      "parameters": {
        "relation": "name_relation:related-name",
        "related_field": "col__code_id",
        "allowed_values": ["VIRUS"],
        "skip_if_empty": true
      },
      "error_message": "The two names in this relation are governed by different nomenclatural codes.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
