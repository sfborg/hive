{
  "name": "tw_ext_sfga",
  "version": "0.2.0",
  "domain": "biodiversity",
  "author": "sfborg/hive",
  "description": "TaxonWorks-derived validation rules that apply to names of every nomenclatural code, to name relations, type material and references. These rules need the TaxonWorks round-trip columns, which are a proposal against the sfga schema and not yet adopted: the bundle's requires block names them, and hive skips the bundle and reports the missing columns when an archive does not have them. Each rule's description names the TaxonWorks class and method it is ported from. Statuses are matched as NOMEN ontology URIs in name.col__status_id. Relations are declared in hive_rules.json. Schema compatibility: SFGA v0.3.x.",
  "created_at": "2026-09-22T00:00:00Z",
  "tables": [],
  "requires": {
    "tables": ["tw__otu"],
    "columns": {
      "name.tw__name_class": "text",
      "name.tw__nomenclatural_classification": "text",
      "name.tw__verbatim_author": "text",
      "name.tw__verbatim_name": "text",
      "name.tw__year_of_publication": "text",
      "name_relation.tw__name_relationship_type": "text"
    },
    "relations": ["name:element-form", "name:element-genus", "name:element-originalform", "name:element-originalgenus", "name:element-originalspecies", "name:element-originalsubform", "name:element-originalsubgenus", "name:element-originalsubspecies", "name:element-originalsubvariety", "name:element-originalvariety", "name:element-section", "name:element-series", "name:element-species", "name:element-subform", "name:element-subgenus", "name:element-subsection", "name:element-subseries", "name:element-subspecies", "name:element-subvariety", "name:element-variety", "name:otu"]
  },
  "relations": {},
  "supersedes": ["tw_basionym_authorship_without_digits", "tw_combination_authorship_without_digits", "tw_duplicate_taxon", "tw_rank_required", "tw_status_code_root", "tw_status_is_grammatical_term"],
  "rules": [
    {
      "rule_id": "tw_ext_rank_required",
      "table_name": "name",
      "field_name": "col__rank_id",
      "rule_name": "Rank is recorded for a protonym",
      "description": "Ported from TaxonWorks Protonym validates_presence_of :rank_class (app/models/protonym.rb).",
      "validator_type": "presence",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "tw__name_class", "operator": "not_equals", "value": "Combination"}],
      "parameters": {},
      "error_message": "Every protonym needs a rank.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_ext_status_code_root",
      "table_name": "name",
      "field_name": "tw__nomenclatural_classification",
      "rule_name": "Statuses are specific",
      "description": "Ported from TaxonWorks TaxonNameClassification#validate_taxon_name_classification (app/models/taxon_name_classification.rb).",
      "validator_type": "absence",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [
        {
          "field": "tw__nomenclatural_classification",
          "operator": "matches",
          "value": "(?:http://purl\\.obolibrary\\.org/obo/NOMEN_0000107|http://purl\\.obolibrary\\.org/obo/NOMEN_0000109|http://purl\\.obolibrary\\.org/obo/NOMEN_0000110|http://purl\\.obolibrary\\.org/obo/NOMEN_0000111)"
        }
      ],
      "parameters": {},
      "error_message": "A status on this name is only the name of a nomenclatural code. Choose specific statuses.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_ext_year_of_publication_integer",
      "table_name": "name",
      "field_name": "tw__year_of_publication",
      "rule_name": "Year of publication is an integer",
      "description": "Ported from TaxonWorks TaxonName validates :year_of_publication, date_year (app/models/taxon_name.rb).",
      "validator_type": "regex",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "tw__year_of_publication", "operator": "not_equals", "value": ""}],
      "parameters": {"pattern": "^[0-9]+$"},
      "error_message": "The year of publication must be a whole number.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_ext_year_of_publication_range",
      "table_name": "name",
      "field_name": "tw__year_of_publication",
      "rule_name": "Year of publication is plausible",
      "description": "Ported from TaxonWorks TaxonName validates :year_of_publication, date_year (app/models/taxon_name.rb).",
      "validator_type": "range",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "tw__year_of_publication", "operator": "matches", "value": "^[0-9]+$"}],
      "parameters": {"min": 1000, "max": "current_year"},
      "error_message": "The year of publication must be between 1000 and the current year.",
      "warning_message": "",
      "is_active": true,
      "priority": 15
    },
    {
      "rule_id": "tw_ext_verbatim_author_without_digits",
      "table_name": "name",
      "field_name": "tw__verbatim_author",
      "rule_name": "Author contains no digits",
      "description": "Ported from TaxonWorks Protonym#verbatim_author_without_digits (app/models/protonym.rb).",
      "validator_type": "regex",
      "enforcement": "hard",
      "severity": "error",
      "conditions": [{"field": "tw__verbatim_author", "operator": "not_equals", "value": ""}],
      "parameters": {"pattern": "^[^0-9]*$"},
      "error_message": "The author must not contain digits; the year belongs in its own field.",
      "warning_message": "",
      "is_active": true,
      "priority": 20
