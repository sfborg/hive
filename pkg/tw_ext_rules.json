    {
      "rule_id": "tw_ext_combination_duplicate",
      "table_name": "name",
      "field_name": "col__scientific_name",
      "rule_name": "Duplicate combination",
      "description": "Ported from TaxonWorks Combination#is_unique and #sv_combination_duplicates (app/models/combination.rb).",
      "validator_type": "count_across",
      "enforcement": "soft",
      "severity": "warn",
      "conditions": [{"field": "tw__name_class", "operator": "equals", "value": "Combination"}],
      "parameters": {
        "table": "name",
        "match": [
          {"target": "col__scientific_name", "self": "col__scientific_name"},
          {"target": "tw__verbatim_name", "self": "tw__verbatim_name"}
        ],
        "exclude_self": true,
        "expected": {"max": 0},
        "skip_if_any_self_empty": false
      },
      "error_message": "",
      "warning_message": "Another combination has the same name and verbatim name.",
      "is_active": true,
      "priority": 30
    },
