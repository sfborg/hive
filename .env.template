# Copy this file to .env and fill in real values. Docker Compose
# auto-loads .env from this directory and uses it to fill ${VAR}
# interpolations in docker-compose.yml. The .env file itself is
# gitignored; this template is checked in as a starting point.
#
# Syntax: KEY=value, one per line, no quotes, no `export`, no
# spaces around `=`.
#
# For each entry here, the hive service's environment: block in
# docker-compose.yml forwards the variable into the container.
# Hive's own config file (~/.config/sfborg/hive/config.yml, or a
# mount into the container) references the variable via:
#     credential:
#       source: env
#       env_var: ANTHROPIC_API_KEY

ANTHROPIC_API_KEY=sk-ant-replace-me
